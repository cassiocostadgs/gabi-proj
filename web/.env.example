# Caminho para o Oracle Instant Client (thick mode obrigatório — Oracle 11g)
# macOS: /opt/oracle/instantclient_23_26
# Linux: /opt/oracle/instantclient_21_x
ORACLE_INSTANT_CLIENT=/opt/oracle/instantclient_23_26

# Conexão com o Task DB (Oracle)
# Host/porta variam por ambiente:
#   local + VPN  → 192.168.199.99 / 1521   (rede interna)
#   local sem VPN → deixar ORACLE_HOST vazio — Oracle desabilitado, usa fallback de arquivo
#   EC2 (prod)   → 177.125.219.50 / 15210  (IP público; firewall whitelist só para o EC2)
#                   gerenciado pelos secrets do GitHub Actions — não editar manualmente no servidor
ORACLE_HOST=192.168.199.99
ORACLE_PORT=1521
ORACLE_SID=orcl
ORACLE_USER=taskconsulta
ORACLE_PASSWORD=taskconsulta
ORACLE_TASK_PROJECT=DGS_MAG
