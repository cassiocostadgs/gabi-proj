# G.A.B.I. environment variables — copy to .env and fill in real values.
# .env is gitignored; never commit actual secrets.

# ── Authentication ────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-random-hex-string
ADMIN_EMAIL=admin@db1.com.br
ADMIN_PASSWORD=change-me

# ── Oracle Task DB ────────────────────────────────────────────────────────────
ORACLE_INSTANT_CLIENT=/opt/oracle/instantclient_23_26
ORACLE_HOST=192.168.199.99
ORACLE_PORT=1521
ORACLE_SID=orcl
ORACLE_USER=taskconsulta
ORACLE_PASSWORD=change-me

# ── TL Evaluation domain (Anthropic API) ─────────────────────────────────────
# Dedicated Workspace key under DB1's Anthropic organization.
# Never use an individual TL's Pro/Max subscription key here.
ANTHROPIC_API_KEY=sk-ant-...
