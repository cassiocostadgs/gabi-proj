sonar.projectKey=GABI
sonar.projectName=G.A.B.I.
sonar.projectVersion=2.0.0

sonar.host.url=http://localhost:9000
sonar.token=SEU_TOKEN_AQUI

# Sources
sonar.sources=web,extracted
sonar.sourceEncoding=UTF-8

# Python
sonar.python.version=3.11

# Exclusions
sonar.exclusions=\
  web/__pycache__/**,\
  web/tasks/**,\
  web/static/index.html,\
  **/*.pyc,\
  **/test_*,\
  **/*_test.py

# HTML/JS (separate from Python sources)
sonar.html.file.suffixes=.html

# Coverage (gerado por: pytest --cov=web --cov-report=xml)
sonar.python.coverage.reportPaths=coverage.xml
